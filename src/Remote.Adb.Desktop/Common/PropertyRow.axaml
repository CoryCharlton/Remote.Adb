<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:Remote.Adb.Desktop.Common"
             x:Class="Remote.Adb.Desktop.Common.PropertyRow"
             x:DataType="common:AvdField"
             IsVisible="{Binding RowVisible}">

    <!-- A single label → value line. Read mode shows the value as text; edit mode swaps in a dropdown (for
         fields with a fixed choice set) or a text box, toggled by the field's own ShowEditor flags so there's
         no ancestor binding. The TextBox surfaces inline validation errors automatically. -->
    <Grid ColumnDefinitions="150,*" Margin="0,3">
        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="BodySmall"
                   Foreground="{DynamicResource OnSurfaceVariant}" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>

        <SelectableTextBlock Grid.Column="1" Text="{Binding ReadText}" Classes="BodyMedium"
                             Foreground="{DynamicResource OnSurface}" TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !ShowEditor}"/>

        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding Value, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding ShowChoiceEditor}"/>

        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                 IsVisible="{Binding ShowTextEditor}"/>
    </Grid>

</UserControl>
