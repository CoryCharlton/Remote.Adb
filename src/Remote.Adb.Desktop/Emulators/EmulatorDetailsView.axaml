<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emu="using:Remote.Adb.Desktop.Emulators"
             xmlns:common="using:Remote.Adb.Desktop.Common"
             x:Class="Remote.Adb.Desktop.Emulators.EmulatorDetailsView"
             x:DataType="emu:EmulatorDetailsViewModel">

    <!-- A force-filled Panel hosts a Grid(Auto,*): the header is pinned in the Auto row while only the body
         (the *-row ScrollViewer) scrolls. The * row bounds the ScrollViewer to the viewport, so the body
         scrolls to the bottom; the inset lives on the ItemsControl's Margin, never the ScrollViewer's
         Padding (which would leave the last group unreachable). -->
    <Panel>
        <Grid RowDefinitions="Auto,*">

            <!-- Pinned header: back, title, edit/save/cancel actions, and the save status line. -->
            <StackPanel Grid.Row="0" Spacing="8" Margin="24,24,24,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="Icon" Command="{Binding BackCommand}" ToolTip.Tip="Back"
                            VerticalAlignment="Top" Margin="0,0,8,0">
                        <PathIcon Data="{StaticResource IconCaretLeft}" Width="20" Height="20"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" Classes="HeadlineSmall"
                                   Foreground="{DynamicResource OnSurfaceStrong}"/>
                        <TextBlock Text="{Binding Subtitle}" Classes="BodySmall"
                                   Foreground="{DynamicResource OnSurfaceVariant}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="Edit" Command="{Binding EditCommand}"
                                IsVisible="{Binding !IsEditing}"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsEditing}"/>
                        <Button Content="Save" Classes="Filled" Command="{Binding SaveCommand}"
                                IsVisible="{Binding IsEditing}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Classes="BodySmall" Foreground="{DynamicResource Error}" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>

            <!-- Scrolling body: the divider-separated config sections, flush on the page (no card). -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="24,0,24,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="common:DetailGroup">
                            <common:PropertyGroupView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Panel>

</UserControl>
