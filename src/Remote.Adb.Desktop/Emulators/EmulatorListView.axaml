<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emu="using:Remote.Adb.Desktop.Emulators"
             xmlns:common="using:Remote.Adb.Desktop.Common"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             x:Class="Remote.Adb.Desktop.Emulators.EmulatorListView"
             x:DataType="emu:EmulatorViewModel">

    <!-- A Panel z-stacks the content grid, the floating Create button, and the busy overlay. The content is a
         Grid(Auto,*): a pinned top bar (Refresh text button) over the scrolling list. The * row bounds the
         ScrollViewer to the viewport; the page inset lives on the ItemsControl's Margin (never the
         ScrollViewer's Padding, which would leave the last cards unreachable). -->
    <Panel>
        <Grid RowDefinitions="Auto,*">

            <Button Grid.Row="0" Classes="Text" Content="Refresh" HorizontalAlignment="Right"
                    Margin="24,12,24,0" Command="{Binding RefreshCommand}"/>

            <ScrollViewer Grid.Row="1">
                <!-- 24 sides = the Spacing6 page inset; extra bottom room lets the last card clear the FAB. -->
                <ItemsControl ItemsSource="{Binding Emulators}" Margin="24,12,24,88">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="emu:EmulatorDeviceViewModel">
                            <emu:EmulatorCardView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <common:EmptyState IsVisible="{Binding IsListEmpty}"
                           IconData="{StaticResource IconAndroidLogo}"
                           Title="No emulators yet"
                           Description="Create an Android Virtual Device to get started — use the + button below."/>

        <!-- Error status, bottom-left; left/bottom match the page inset, right clears the button. -->
        <TextBlock VerticalAlignment="Bottom" Margin="24,0,88,24" TextWrapping="Wrap"
                   Classes="BodySmall" Foreground="{DynamicResource Error}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding StatusMessage}"/>

        <!-- Primary action: create a new AVD. Inset to align with the card edge. -->
        <theme:FloatingActionButton HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,24,24" ToolTip.Tip="Create AVD"
                                    Command="{Binding CreateCommand}">
            <PathIcon Data="{StaticResource IconPlus}" Width="24" Height="24"/>
        </theme:FloatingActionButton>

        <common:BusyOverlay IsVisible="{Binding IsBusy}"/>

    </Panel>

</UserControl>
