<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dev="using:Remote.Adb.Desktop.Devices"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             x:Class="Remote.Adb.Desktop.Devices.DeviceCardView"
             x:DataType="dev:DeviceRowViewModel">

    <!-- One device row. Read-only: a connection snapshot from `adb devices -l`. -->
    <theme:Card Classes="Elevated">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0"
                      VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}"
                      Data="{StaticResource IconDeviceMobile}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding DisplayName}" Classes="TitleMedium"
                           Foreground="{DynamicResource OnSurface}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Serial}" Classes="BodySmall"
                               Foreground="{DynamicResource OnSurfaceVariant}"/>
                    <TextBlock Text="{Binding Summary}" Classes="BodySmall"
                               Foreground="{DynamicResource OnSurfaceVariant}"
                               IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </StackPanel>

            <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateLabel}" Classes="BodySmall"
                           Foreground="{DynamicResource Primary}" IsVisible="{Binding IsOnline}"/>
                <TextBlock Text="{Binding StateLabel}" Classes="BodySmall"
                           Foreground="{DynamicResource Error}" IsVisible="{Binding !IsOnline}"/>
            </Panel>
        </Grid>
    </theme:Card>

</UserControl>
