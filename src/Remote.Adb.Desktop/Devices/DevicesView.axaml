<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dev="using:Remote.Adb.Desktop.Devices"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Remote.Adb.Desktop.Devices.DevicesView"
             x:DataType="dev:DevicesViewModel">

    <!-- Thin shell for the in-page master-detail. Both children sit DIRECTLY in the Panel (not via a
         ContentControl) so the detail's ScrollViewer is force-filled to the viewport and can scroll fully.
         The detail (an AVD's config) binds to SelectedDetail; its visibility is driven off the page view
         model reached through the named shell (its own DataContext is the detail, not the page). -->
    <Panel x:Name="Shell">
        <dev:DevicesListView IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNull}}"/>
        <dev:AvdDetailsView DataContext="{Binding SelectedDetail}"
                            IsVisible="{Binding #Shell.((dev:DevicesViewModel)DataContext).SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Panel>

</UserControl>
