<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Remote.Adb.Desktop.Tunnel"
             xmlns:common="using:Remote.Adb.Desktop.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Remote.Adb.Desktop.Tunnel.TunnelView"
             x:DataType="vm:TunnelViewModel">

    <common:EmptyState IconData="{StaticResource IconPlugsConnected}"
                       Title="{Binding Title}" Description="{Binding Description}"/>

</UserControl>
